# Copy to .env. Do not commit .env or share screenshots containing its contents.
# One distinct account per person/business. Generate each hash with:
# node scripts/hash-password.mjs
# Keep the single quotes around the JSON so Compose preserves literal $ in hashes.
# Replace the hash placeholder only. Keep the {"bruno":"..."} JSON wrapper.
PILOT_USERS_JSON='{"bruno":"REPLACE_WITH_HASH_FROM_SCRIPT"}'

# Generate TWO DIFFERENT random values, each at least 32 characters.
# Example command, run twice: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Bind webhook secret in n8n Header Auth credential: Name X-Pilot-Key.
N8N_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_WEBHOOK_SECRET
# Keep this encryption key unchanged after first n8n startup; back it up securely.
N8N_ENCRYPTION_KEY=REPLACE_WITH_DIFFERENT_RANDOM_ENCRYPTION_KEY

WEB_PORT=3000
N8N_EDITOR_PORT=5679
APP_ORIGIN=http://localhost:3000
SECURE_COOKIE=false
MAX_UPLOAD_MB=5
PROCESSING_TIMEOUT_MS=65000
RESULT_TTL_MINUTES=15
SESSION_TTL_HOURS=8
MAX_CONCURRENT_UPLOADS=2
MAX_JOBS_PER_SESSION=3
MAX_STORED_BYTES=134217728

# Only used by npm start on Windows. Compose uses the private Docker hostname.
HOST=127.0.0.1
PORT=3000
N8N_WEBHOOK_URL=http://localhost:5679/webhook/sales-web
N8N_QUOTATION_WEBHOOK_URL=http://localhost:5679/webhook/quotation-web

# Optional future HTTPS deployment, not needed locally.
DOMAIN=pilot.example.com
ACME_EMAIL=you@example.com
